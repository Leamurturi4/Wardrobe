GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Brave Search API subscription token. Without it, Inspired mode in the Outfit
# Lab falls back to wardrobe-only recommendations.
INSPIRATION_SEARCH_API_KEY=
INSPIRATION_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
INSPIRATION_SEARCH_TIMEOUT_MS=6000
INSPIRATION_CACHE_TTL_MS=900000
